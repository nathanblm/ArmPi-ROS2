FROM ros:humble-ros-base-jammy

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        iproute2 \
        procps \
        python3-colcon-common-extensions \
        python3-numpy \
        python3-pip \
        python3-rosdep \
        python3-serial \
        python3-vcstool \
        usbutils \
        v4l-utils \
    && rm -rf /var/lib/apt/lists/*

RUN test -e /etc/ros/rosdep/sources.list.d/20-default.list || rosdep init

WORKDIR /workspace

CMD ["sleep", "infinity"]
