<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>armpi_fpv_bringup</name>
  <version>0.1.0</version>
  <description>ROS 2 hardware and camera bringup for the Hiwonder ArmPi-FPV.</description>
  <maintainer email="support@hiwonder.com">Hiwonder</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>armpi_fpv_description</exec_depend>
  <exec_depend>kinematics</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_robot_controller</exec_depend>
  <exec_depend>servo_controller</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>web_video_server</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
